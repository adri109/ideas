# Server
PORT=3000
HOST=0.0.0.0

# Gmail OAuth (descarga credentials.json desde Google Cloud Console)
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json
GMAIL_USER_ID=me

# Google Pub/Sub (tema al que Gmail publica notificaciones)
PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/gmail-inbox

# Cursor Automation webhook
CURSOR_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/YOUR_AUTOMATION_ID
CURSOR_WEBHOOK_TOKEN=crsr_YOUR_TOKEN

# Almacenamiento local de IDs procesados
PROCESSED_STORE_PATH=./data/processed.json

# Opcional: validar que el push viene de Pub/Sub (audience de la suscripción push)
# PUBSUB_AUDIENCE=https://tu-dominio.com/pubsub/gmail
