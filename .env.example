# Server
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# Secreto para firmar cookies de sesión (genera uno aleatorio de 32+ chars)
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Gmail OAuth — credenciales de Google Cloud (tipo Web application)
GMAIL_CREDENTIALS_PATH=./credentials.json
# URI de redirección autorizada en Google Cloud:
#   http://localhost:3000/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Google Pub/Sub (tema al que Gmail publica notificaciones)
PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/gmail-inbox

# Cursor Automation webhook
CURSOR_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/YOUR_AUTOMATION_ID
CURSOR_WEBHOOK_TOKEN=crsr_YOUR_TOKEN

# Almacenamiento
GMAIL_TOKEN_DIR=./data/tokens
PROCESSED_STORE_PATH=./data/processed.json

# Opcional: validar que el push viene de Pub/Sub (audience de la suscripción push)
# PUBSUB_AUDIENCE=https://tu-dominio.com/pubsub/gmail
